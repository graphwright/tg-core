# Docker image and workspace defaults
UBUNTU_VERSION=24.04
WORKDIR_PATH=/app

# Local SSH key file name under ~/.ssh/
SSH_KEY_FILE=ww_id_ed25519

# SSH options for Git operations inside the container
GIT_SSH_OPTIONS=-o IdentitiesOnly=yes -o StrictHostKeyChecking=yes

# Required: personal git commit identity used inside container
GIT_USER_NAME=Will Ware
GIT_USER_EMAIL=wware@alum.mit.edu
GITHUB_EXPECTED_USERNAME=wware

# Optional: private package index for pip/pdm installs
# Example: https://__token__:YOUR_TOKEN@your-index.example.com/simple
PIP_INDEX_URL=
